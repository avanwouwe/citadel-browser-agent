#!/bin/sh
# Installs Citadel's policy for Snap Chromium, which ignores
# /etc/chromium/policies and reads its own data directory instead.
# Idempotent; run as root by postinstall.sh and by citadel-snap-policy.timer
# so the policy also appears when the snap is installed after the package.
set -eu

SOURCE="/usr/share/citadel-browser-agent/chromium-policy.json"
DIR="/var/snap/chromium/current/policies/managed"
TARGET="$DIR/citadel-policy.json"

# Chromium snap not installed (yet).
[ -d /var/snap/chromium/current ] || exit 0

if [ ! -f "$SOURCE" ]; then
    echo "Citadel: packaged Chromium policy is missing: $SOURCE" >&2
    exit 1
fi

if [ -f "$TARGET" ] && cmp -s "$SOURCE" "$TARGET"; then
    exit 0
fi

install -d -m 0755 "$DIR"
install -m 0644 "$SOURCE" "$TARGET"
echo "Citadel: installed Snap Chromium policy: $TARGET"
