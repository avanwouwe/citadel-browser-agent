#!/usr/bin/env bash
#
# Per-user setup for browsers that cannot use the package's system-wide files:
# Flatpak and Snap browsers. APT/RPM browsers are covered entirely by the
# system-wide manifests and policies shipped in the package.
#
# Run automatically by the packaged systemd user timer
# (/usr/lib/systemd/user/citadel-browser-setup.timer), or manually.
set -euo pipefail

AGENT_DIR=/opt/citadel-agent
AGENT="$AGENT_DIR/citadel-browser-agent"
CHROMIUM_TEMPLATE="$AGENT_DIR/manifests/citadel.browser.agent.json"
FIREFOX_TEMPLATE="$AGENT_DIR/manifests/citadel.browser.agent-firefox.json"
MANIFEST_NAME=citadel.browser.agent.json

STATE_DIR="$HOME/.local/state/citadel-browser-setup"


# name | Flatpak app id | manifest flavour | manifest dir (relative to $HOME)
FLATPAK_TARGETS=(
    "Chrome|com.google.Chrome|chromium|.var/app/com.google.Chrome/config/google-chrome/NativeMessagingHosts"
    "Chromium|org.chromium.Chromium|chromium|.var/app/org.chromium.Chromium/config/chromium/NativeMessagingHosts"
    "Firefox|org.mozilla.firefox|firefox|.var/app/org.mozilla.firefox/.mozilla/native-messaging-hosts"
    "Brave|com.brave.Browser|chromium|.var/app/com.brave.Browser/config/BraveSoftware/Brave-Browser/NativeMessagingHosts"
    "Opera|com.opera.Opera|chromium|.var/app/com.opera.Opera/config/google-chrome/NativeMessagingHosts"
    "Edge|com.microsoft.Edge|chromium|.var/app/com.microsoft.Edge/config/microsoft-edge/NativeMessagingHosts"
)

# name | snap name | manifest flavour | manifest dir (relative to $HOME)
# N.B. there are no Chrome snap packages.
# TODO: Firefox native messaging also works from a plain host manifest
# (the staged copy may be unnecessary); verify and drop the staging.
SNAP_TARGETS=(
    "Chromium|chromium|chromium|snap/chromium/common/chromium/NativeMessagingHosts"
    "Firefox|firefox|firefox|snap/firefox/common/.mozilla/native-messaging-hosts"
    "Brave|brave|chromium|snap/brave/current/.config/BraveSoftware/Brave-Browser/NativeMessagingHosts"
    "Opera|opera|chromium|snap/opera/current/.config/google-chrome/NativeMessagingHosts"
)

configured=()
skipped=()
failed=()
fingerprint=

die() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'Warning: %s\n' "$*" >&2
}

report() {
    local item
    printf '\nConfigured:\n'
    if ((${#configured[@]})); then
        for item in "${configured[@]}"; do printf '  - %s\n' "$item"; done
    else
        printf '  - None\n'
    fi

    printf '\nNot installed:\n'
    if ((${#skipped[@]})); then
        for item in "${skipped[@]}"; do printf '  - %s\n' "$item"; done
    else
        printf '  - None\n'
    fi

    if ((${#failed[@]})); then
        printf '\nFailed:\n'
        for item in "${failed[@]}"; do printf '  - %s\n' "$item"; done
    fi
}

flatpak_installed() {
    command -v flatpak >/dev/null 2>&1 &&
        flatpak info "$1" >/dev/null 2>&1
}

snap_installed() {
    command -v snap >/dev/null 2>&1 &&
        snap list "$1" >/dev/null 2>&1
}

template_for() {
    case $1 in
        chromium) printf '%s\n' "$CHROMIUM_TEMPLATE" ;;
        firefox)  printf '%s\n' "$FIREFOX_TEMPLATE" ;;
        *)        return 1 ;;
    esac
}

# Run one configuration step; a failure is recorded and does not stop the
# remaining browsers from being configured.
run_step() {
    local label=$1
    shift
    if "$@"; then
        configured+=("$label")
    else
        warn "could not configure $label"
        failed+=("$label")
    fi
}

# Validate the template, replace only its executable path, and atomically
# publish the resulting manifest. Keep origins/extensions from the template.
write_manifest() {
    local template=$1 destination=$2 executable=$3
    mkdir -p "$(dirname "$destination")" || return 1

    python3 - "$template" "$destination" "$executable" <<'PY'
import json
import os
import sys
import tempfile

template, destination, executable = sys.argv[1:]
with open(template, encoding="utf-8") as source:
    manifest = json.load(source)

if manifest.get("name") != "citadel.browser.agent":
    raise SystemExit(f"Unexpected native messaging host name in {template}")

manifest["path"] = executable
directory = os.path.dirname(destination)
fd, temporary = tempfile.mkstemp(prefix=".citadel-manifest-", dir=directory)

try:
    with os.fdopen(fd, "w", encoding="utf-8") as output:
        json.dump(manifest, output, indent=2)
        output.write("\n")
    os.chmod(temporary, 0o644)
    os.replace(temporary, destination)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY
}

# The wrapper lives under this particular Flatpak application's data
# directory, so the application can execute it inside its sandbox.
write_flatpak_wrapper() {
    local destination=$1
    local temporary

    mkdir -p "$(dirname "$destination")" || return 1
    temporary=$(mktemp "$(dirname "$destination")/.citadel-wrapper.XXXXXXXX") ||
        return 1

    if ! printf '#!/bin/sh\nexec flatpak-spawn --host %q "$@"\n' "$AGENT" \
            >"$temporary" ||
       ! chmod 755 "$temporary" ||
       ! mv -f -- "$temporary" "$destination"; then
        rm -f -- "$temporary"
        return 1
    fi
}

configure_flatpak() {
    local app_id=$1 template=$2 manifest_dir=$3
    local wrapper="$HOME/.var/app/$app_id/data/citadel-browser-agent/citadel-browser-agent-wrapper"

    # The wrapper runs the agent on the host through flatpak-spawn, which a
    # sandboxed browser may only do with this permission. Per-user and
    # idempotent; it lets the app run host commands, which is inherent to
    # this approach.
    flatpak override --user --talk-name=org.freedesktop.Flatpak "$app_id" ||
        return 1
    # Opera cannot see the host's /etc, where its policy (force-install)
    # lives. Chrome, Brave and Edge ship with this permission already.
    if [[ $app_id == com.opera.Opera ]]; then
        flatpak override --user --filesystem=host-etc:ro "$app_id" ||
            return 1
    fi
    write_flatpak_wrapper "$wrapper" || return 1
    write_manifest "$template" "$manifest_dir/$MANIFEST_NAME" "$wrapper"
}

# Identifies the content of the installed agent without reading it: the path,
# size and mtime of every file. A new package yields a new fingerprint.
agent_fingerprint() {
    find "$AGENT_DIR" -type f -printf '%P\t%s\t%T@\n' |
        LC_ALL=C sort | sha256sum | cut -c1-16
}

# Only delete an old copy if lsof positively establishes that it has no
# open files. Any ambiguous lsof result, or a missing lsof, retains the copy.
clean_old_snap_copies() {
    local common=$1 active=$2 candidate output errors status

    if ! command -v lsof >/dev/null 2>&1; then
        warn "lsof not found; old Snap agent copies are not cleaned up"
        return 0
    fi

    while IFS= read -r -d '' candidate; do
        [[ $candidate != "$active" ]] || continue

        output=$(mktemp)
        errors=$(mktemp)
        status=0
        lsof -t +D "$candidate" >"$output" 2>"$errors" || status=$?

        if [[ $status -eq 1 && ! -s $output && ! -s $errors ]]; then
            rm -rf -- "$candidate"
        fi

        rm -f -- "$output" "$errors"
    done < <(
        find "$common" -maxdepth 1 -type d \
            -name 'citadel-agent.*' -mtime +6 -print0
    )
}

# A confined browser can only execute files inside its own snap directory, so
# the agent is copied there. The copy is named after the agent's fingerprint
# and reused until the package changes.
configure_snap() {
    local snap_name=$1 template=$2 manifest_dir=$3
    local common="$HOME/snap/$snap_name/common"
    local final stage leftover

    mkdir -p "$common" || return 1

    if [[ -z $fingerprint ]]; then
        fingerprint=$(agent_fingerprint) || return 1
    fi
    final="$common/citadel-agent.$fingerprint"

    # Leftovers of interrupted runs; the lock rules out a concurrent run.
    for leftover in "$common"/.citadel-stage.*; do
        [[ ! -d $leftover ]] || rm -rf -- "$leftover"
    done

    if [[ ! -x $final/citadel-browser-agent ]]; then
        stage=$(mktemp -d "$common/.citadel-stage.XXXXXXXX") || return 1

        if ! cp -a "$AGENT_DIR/." "$stage/" ||
           [[ ! -x $stage/citadel-browser-agent ]]; then
            rm -rf -- "$stage"
            return 1
        fi

        # Make the mtime reflect creation, not the source's.
        touch "$stage"
        rm -rf -- "$final"
        if ! mv -T -- "$stage" "$final"; then
            rm -rf -- "$stage"
            return 1
        fi
    fi

    # Publish the manifest only once the complete copy is in place.
    write_manifest "$template" "$manifest_dir/$MANIFEST_NAME" \
        "$final/citadel-browser-agent" || return 1

    clean_old_snap_copies "$common" "$final"
}

[[ ${EUID:-$(id -u)} -ne 0 ]] || die "Run as your normal user, not with sudo"
[[ $# -eq 0 ]] || die "Usage: citadel-browser-setup"

command -v flock >/dev/null 2>&1 || die "flock is required"
mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/setup.lock"
flock -w 120 9 || die "Another instance is running (lock timeout)"

command -v python3 >/dev/null 2>&1 || die "python3 is required"
[[ -x $AGENT ]] || die "Agent not executable: $AGENT"
[[ -r $CHROMIUM_TEMPLATE ]] || die "Missing Chromium manifest template"
[[ -r $FIREFOX_TEMPLATE ]] || die "Missing Firefox manifest template"

# Flatpak.
for entry in "${FLATPAK_TARGETS[@]}"; do
    IFS='|' read -r name id kind dir <<<"$entry"
    if flatpak_installed "$id"; then
        run_step "$name (Flatpak)" configure_flatpak "$id" \
            "$(template_for "$kind")" "$HOME/$dir"
    else
        skipped+=("$name (Flatpak)")
    fi
done

# Snap.
for entry in "${SNAP_TARGETS[@]}"; do
    IFS='|' read -r name id kind dir <<<"$entry"
    if snap_installed "$id"; then
        run_step "$name (Snap)" configure_snap "$id" \
            "$(template_for "$kind")" "$HOME/$dir"
        snap_found=1
    else
        skipped+=("$name (Snap)")
    fi
done

report

if [[ ${snap_found:-0} -eq 1 ]]; then
    printf '\nAlready-running native hosts may need to reconnect to read updated config.\n'
fi

((${#failed[@]} == 0)) || exit 1
